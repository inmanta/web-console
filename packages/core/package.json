{
  "name": "@inmanta/web-console-core",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "devDependencies": {
    "@inmanta/web-console-test-utils": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/qs": "^6.15.1",
    "msw": "^2.15.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.7.0",
    "@tanstack/react-query": "^5.105.0",
    "bignumber.js": "^11.1.5",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "graphql": "^17.0.2",
    "jsonpathly": "^3.0.1",
    "keycloak-js": "^26.2.5",
    "qs": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "uuid": "^14.0.3",
    "xml-formatter": "^3.7.0"
  }
}

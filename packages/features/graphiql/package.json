{
  "name": "@inmanta/web-console-feature-graphiql",
  "private": true,
  "type": "module",
  "inmanta": {
    "edition": "oss"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./vite.js",
      "default": "./vite.js"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "dependencies": {
    "@graphiql/react": "^1.0.2",
    "@graphiql/toolkit": "^1.0.1",
    "@inmanta/web-console-core": "workspace:^",
    "@inmanta/web-console-ui": "workspace:^",
    "@patternfly/react-icons": "^6.7.0",
    "@tanstack/react-query": "^5.107.1",
    "graphiql": "^6.0.1",
    "graphql": "^17.1.0",
    "monaco-editor": "^0.57.0",
    "monaco-graphql": "^2.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@inmanta/web-console-test-utils": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "msw": "^3.0.4",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}

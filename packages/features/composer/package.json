{
  "name": "@inmanta/web-console-feature-composer",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "dependencies": {
    "@inmanta/web-console-core": "workspace:^",
    "@inmanta/web-console-ui": "workspace:^",
    "@joint/plus": "^4.3.4",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-tokens": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "styled-components": "^6.6.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@inmanta/web-console-test-utils": "workspace:^",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

{
  "name": "@inmanta/web-console-feature-composer",
  "private": true,
  "type": "module",
  "inmanta": {
    "edition": "iso"
  },
  "scripts": {
    "build": "vite build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./vite.js",
      "default": "./vite.js"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@inmanta/web-console-core": "workspace:^",
    "@inmanta/web-console-ui": "workspace:^",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "styled-components": "^6.6.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@inmanta/web-console-test-utils": "workspace:^",
    "@module-federation/vite": "1.23.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}

{
  "name": "@inmanta/web-console-shell",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "dependencies": {
    "@inmanta/web-console-core": "workspace:^",
    "@inmanta/web-console-ui": "workspace:^"
  },
  "devDependencies": {
    "@inmanta/web-console-test-utils": "workspace:^"
  }
}

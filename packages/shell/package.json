{
  "name": "@inmanta/web-console-shell",
  "private": true,
  "type": "module",
  "inmanta": {
    "edition": "oss"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "dependencies": {
    "@inmanta/web-console-core": "workspace:^",
    "@inmanta/web-console-ui": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-tokens": "^6.7.0",
    "@react-keycloak/web": "^3.4.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "keycloak-js": "^26.2.5",
    "monaco-editor": "^0.52.2",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.5.1",
    "styled-components": "^6.6.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@inmanta/web-console-test-utils": "workspace:^",
    "@remix-run/router": "^1.23.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "jest-axe": "^11.0.0",
    "msw": "^2.15.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/root",
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.shared.ts",
    "vitest.config.ts",
    "apps/*/vite.config.ts",
    "packages/features/*/vite.js",
    "packages/features/*/vite.test.ts",
    "packages/features/*/vite.config.ts",
    "__mocks__/**/*.ts",
    "src",
    "cypress/support"
  ]
}

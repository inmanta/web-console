{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "lib": [
      "ES2022",
      "dom"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules",
      "./src"
    ],
    "paths": {
      "@assets/*": [
        "./node_modules/@patternfly/react-core/dist/styles/assets/*"
      ],
      "@images/*": [
        "./public/images/*"
      ],
      "@rappidcss": [
        "./node_modules/@joint/plus/joint-plus.css"
      ]
    },
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true
  }
}

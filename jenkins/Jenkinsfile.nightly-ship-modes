// The nightly checks of the composer's ship modes: the ISO end-to-end suite once for each mode
// the ISO web console can run in (see "Features loaded at runtime" in docs/notes.md):
// - combined: dist/ as built, with the composer;
// - without: no composer files;
// - mismatch: a composer of another version, which the app leaves out with a notice.
// The scenario of the composer itself (scenario-8-composer) only runs in the combined mode.
// Then `yarn cypress-test:ship-modes` (cypress/e2e/ShipModes), which switches between the modes
// while the app runs, and also covers installing the composer later. Each run gets a fresh
// orchestrator.
//
// Its own job, for master and the iso branches; it needs the same credentials as the main job.
def runs = ['combined', 'without', 'mismatch', 'switching']

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        checkoutToSubdirectory('web-console')
        skipDefaultCheckout()
        ansiColor('xterm')
    }
    triggers {
        cron(BRANCH_NAME ==~ /master|iso[0-9]+/ ? 'H H(0-2) * * *' : '')
    }
    environment {
        GITLAB_TOKEN = credentials('jenkins_on_gitlab')
        JOINTJS_NPM_TOKEN = credentials('jointjs-npm-token')
    }

    stages {
        stage('Ship modes: Checkout') {
            steps {
                deleteDir()
                dir('web-console') {
                    checkout scm
                }
            }
        }
        stage('Ship modes: Build') {
            steps {
                dir('web-console') {
                    sh '''
                    yarn install --immutable
                    yarn build:ci
                    '''
                }
            }
        }
        stage('Ship modes: End-to-end tests') {
            steps {
                script {
                    for (run in runs) {
                        stage("Ship mode: ${run}") {
                            // A failing run fails the build, and the other runs still run.
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                // One orchestrator per agent: the main job's Cypress stage takes the same lock.
                                lock(resource: "orchestrator-${env.NODE_NAME}") {
                                    timeout(time: 30, unit: 'MINUTES') {
                                        dir('web-console') {
                                            // Cypress empties its screenshots folder before each run.
                                            def cypressOptions = "--config screenshotsFolder=cypress/screenshots/${run} --reporter-options 'mochaFile=cypress/reports/junit/${run}-[hash].xml'"
                                            try {
                                                sh '''
                                                sudo systemctl restart docker && sudo docker network prune -f
                                                yarn run install:orchestrator:ci
                                                '''
                                                if (run == 'switching') {
                                                    sh "yarn run cypress-test:ship-modes ${cypressOptions}"
                                                } else {
                                                    sh """
                                                    yarn composer-ship-mode ${run} --container inmanta_orchestrator
                                                    yarn run cypress-test:iso --expose edition=iso,composerShipMode=${run} ${cypressOptions}
                                                    """
                                                }
                                            } finally {
                                                junit allowEmptyResults: true, testResults: "cypress/reports/junit/${run}-*.xml"
                                                sh 'yarn run kill-server || true; rm -rf temp'
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'web-console/cypress/screenshots/**', allowEmptyArchive: true
        }
        cleanup {
            deleteDir()
        }
    }
}

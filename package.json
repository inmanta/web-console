{
  "name": "@inmanta/web-console",
  "version": "4.2.1",
  "description": "Web Console for Inmanta Orchestrator",
  "exports": "./dist/index.js",
  "repository": "https://github.com/inmanta/web-console.git",
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "yarn clean",
    "build": "vite build",
    "build:ci": "node --max-old-space-size=6144 ./node_modules/.bin/vite build && yarn build:sbom",
    "build:sbom": "yarn dlx -q @cyclonedx/yarn-plugin-cyclonedx@3.4.0 --production --output-reproducible -o dist/sbom.cdx.json",
    "start": "dotenv run -- vite",
    "start:https": "HTTPS=true dotenv run -- vite",
    "test": "vitest --run",
    "test:ci": "CI=true vitest --silent",
    "test:ui": "vitest --ui",
    "format": "prettier --check --write \"./**/*.{cjs,js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"./**/*.{cjs,js,jsx,ts,tsx}\"",
    "lint": "eslint --max-warnings=0 -c eslint.config.js",
    "lint:fix": "eslint --max-warnings=0  --quiet --fix",
    "build:bundle-profile": "vite build --mode analyze",
    "bundle-profile:analyze": "yarn build:bundle-profile",
    "clean": "rimraf dist",
    "delete:reports": "rm -r cypress/reports/* || true",
    "precypress-test": "yarn run delete:reports",
    "cypress-test:oss": "yarn cypress run --config-file cypress.config.oss.cjs",
    "cypress-test:iso": "yarn cypress run",
    "cypress-test:keycloak": "yarn cypress run --config-file cypress.config.keycloak.cjs",
    "cypress-test:local-auth": "yarn cypress run --config-file cypress.config.local-auth.cjs",
    "cypress-test:oidc": "yarn cypress run --config-file cypress.config.oidc.cjs",
    "package-cleanup": "node clean_up_packages",
    "check-circular-deps": "depcruise src packages",
    "check-no-cdn": "node scripts/check-no-cdn.js",
    "install:orchestrator:keycloak": "sh ./shell-scripts/setup-auth.sh version='oss' release='dev' branch='oss_case_1'",
    "install:orchestrator:oidc": "sh ./shell-scripts/setup-auth.sh version='oss' release='dev' branch='oss_case_1' auth='oidc'",
    "install:orchestrator:local-auth": "sh ./shell-scripts/setup-auth.sh version='oss' release='dev' branch='oss_case_1' auth='localauth'",
    "install:orchestrator": "sh ./shell-scripts/setup-orchestrator.sh flag='-ti'",
    "install:orchestrator:iso": "sh ./shell-scripts/setup-orchestrator.sh flag='-ti'",
    "install:orchestrator:pxsdc": "sh ./shell-scripts/setup-orchestrator.sh flag='-ti' project='pxsdc'",
    "install:orchestrator:oss": "sh ./shell-scripts/setup-orchestrator.sh flag='-ti' version='oss' release='dev' branch='oss_case_1'",
    "install:orchestrator:ci": "sh ./shell-scripts/setup-orchestrator.sh",
    "kill-server": "sh ./shell-scripts/clear-server.sh",
    "update:dist": "docker exec -u root inmanta_orchestrator rm -rf /usr/share/inmanta/web-console && docker cp dist inmanta_orchestrator:/usr/share/inmanta/web-console"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@remix-run/router": "^1.23.4",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/file-saver": "^2.0.7",
    "@types/jest-axe": "^3.5.9",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cypress": "^16.2.0",
    "dependency-cruiser": "^18.7.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "happy-dom": "^21.0.4",
    "jest-axe": "^11.0.0",
    "markdown-it-emoji": "^3.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.5"
  },
  "browser": {
    "crypto": false
  },
  "dependencies": {
    "@graphiql/react": "^0.39.1",
    "@joint/plus": "^4.3.3",
    "@monaco-editor/react": "^4.7.0",
    "@patternfly/react-charts": "^8.7.0",
    "@patternfly/react-code-editor": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-drag-drop": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@patternfly/react-styles": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@patternfly/react-tokens": "^6.7.0",
    "@react-keycloak/web": "^3.4.0",
    "@tanstack/react-query": "^5.104.5",
    "bignumber.js": "^11.1.5",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "graphiql": "^5.4.0",
    "graphql": "^17.0.2",
    "highlight.js": "^11.12.0",
    "jsonpathly": "^3.0.1",
    "keycloak-js": "^26.2.4",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.52.2",
    "monaco-graphql": "^1.8.0",
    "oidc-client-ts": "^3.5.0",
    "process": "^0.11.10",
    "qs": "^6.16.1",
    "react": "^19.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.4.0",
    "styled-components": "^6.6.0",
    "uuid": "^14.0.3",
    "victory": "^37.3.6",
    "xml-formatter": "^3.7.0"
  },
  "resolutions": {
    "glob": "^10.5.0",
    "json5": "^2.2.2",
    "serialize-javascript": "^7.0.3",
    "qs": "^6.16.1",
    "uuid@^8.3.2": "11.1.1",
    "tar": "^7.5.19"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions"
  ],
  "packageManager": "yarn@4.1.0"
}
